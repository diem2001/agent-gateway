{
  "plain": {
    "schema": {
      "fields": [
        { "key": "token", "label": "API Token", "type": "password", "required": true },
        { "key": "a", "label": "A", "type": "text", "required": true },
        { "key": "b", "label": "B", "type": "text", "required": true }
      ],
      "outputs": [
        { "target": "headers", "outputKey": "X-Token", "template": "{token}" },
        { "target": "headers", "outputKey": "X-Combined", "template": "prefix-{a}-{b}" }
      ]
    },
    "values": { "token": "secret-token", "a": "one", "b": "two" },
    "expected": {
      "headers": {
        "X-Token": "secret-token",
        "X-Combined": "prefix-one-two"
      }
    }
  },
  "basic": {
    "schema": {
      "fields": [
        { "key": "email", "label": "Atlassian Email", "type": "email", "required": true },
        { "key": "apiToken", "label": "API Token", "type": "password", "required": true }
      ],
      "outputs": [
        { "target": "headers", "outputKey": "Authorization", "template": "basic:{email}:{apiToken}" }
      ]
    },
    "values": { "email": "user@example.com", "apiToken": "abc123" },
    "expected": {
      "headers": {
        "Authorization": "Basic dXNlckBleGFtcGxlLmNvbTphYmMxMjM="
      }
    }
  },
  "mixed": {
    "schema": {
      "fields": [
        { "key": "token", "label": "Token", "type": "password", "required": true }
      ],
      "outputs": [
        { "target": "headers", "outputKey": "X-Token", "template": "{token}" },
        { "target": "env", "outputKey": "EXAMPLE_TOKEN", "template": "{token}" }
      ]
    },
    "values": { "token": "shared-secret" },
    "expected": {
      "headers": { "X-Token": "shared-secret" },
      "env": { "EXAMPLE_TOKEN": "shared-secret" }
    }
  }
}
