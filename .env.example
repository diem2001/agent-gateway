# Server
PORT=3001
HOST=0.0.0.0

# Auth — comma-separated label:key pairs
API_KEYS=default:changeme

# Logging (off | info | debug)
LOG_LEVEL=info

# Anthropic Authentication (choose one):
# Option A: OAuth (recommended) — run POST /v1/auth/login after startup, no key needed
# Option B: API Key — set the key below
# ANTHROPIC_API_KEY=sk-ant-...

# Sessions
SESSION_IDLE_TIMEOUT_MS=0
# Default: ./data/sessions.json (Docker override in docker-compose.yml)
# SESSION_PERSIST_PATH=/home/node/.claude/sessions.json

# Event cache TTL (default: 30 minutes)
# EVENT_CACHE_TTL_MS=1800000

# Workspace root for memory/agents/skills (default: $HOME/.claude)
# WORKSPACE_ROOT=/home/node/.claude

# Per-user skill caps (loaded per query via the SDK plugins lever).
# On overflow the excess is dropped deterministically (path-sorted) and a
# skills_truncated NDJSON event is emitted; the query still runs.
# USER_SKILLS_MAX_COUNT=50
# USER_SKILLS_MAX_BYTES=1048576

# Tool Registry (default: ./data/tools.json, Docker override in docker-compose.yml)
# TOOLS_PERSIST_PATH=/home/node/.claude/tools.json

# Streaming upload relay (POST /v1/mcp-servers/:name/uploads/*): abort a relayed
# upload with 504 UPLOAD_TIMEOUT after this many ms without progress in either
# direction. There is no overall deadline. Default: 60000.
# MCP_UPLOAD_IDLE_TIMEOUT_MS=60000

# Overall deadline of one mediated MCP tools/call in an agent run (http, SSE and stdio), in ms: positive whole
# number, empty = 600000, an invalid value stops startup. The relay's 120 s no-progress timeout stays. Webhook tools
# keep their per-tool timeout_ms (default 30 s); direct MCP calls keep MCP_CALL_TIMEOUT_MS.
# AGENT_MCP_TOOL_TIMEOUT_MS=600000

# Tool grant per API-key label (JSON, single-quoted; empty or unset = no restriction). Entries are built-in tool
# names (Bash, Read, ...), mcp__<server>__* or mcp__<server>__<tool> (webhook tools belong to server
# agent-gateway-tools). Deny beats allow; no "allow" = everything a run gets without a policy; "allow": [] =
# nothing; a label entry replaces "default". Every label must exist in API_KEYS, otherwise startup stops with
# FATAL config key=AGENT_TOOL_POLICY (and the container restarts in a loop): change API_KEYS and this together.
# AGENT_TOOL_POLICY='{"default":{"allow":["Read","Grep","mcp__agent-gateway-tools__*"]},"labels":{"cicd":{"allow":["Read","mcp__jira__*"],"deny":["mcp__jira__delete_issue"]}}}'

# Registered MCP servers have an owner (the registering API-key label). Servers registered before ownership have none
# and are unusable for credential-bearing runs until this deploy-step mapping assigns them: "<server>:<label>,..."
# (only ownerless entries, no transfer). A malformed value or the same server twice stops startup with
# FATAL config key=MCP_SERVER_OWNERS (and the container restarts in a loop). Read back in the log:
# mcp.registry.ownerless count=0 names= saved=true
# MCP_SERVER_OWNERS=jira:reqlift

# Workspace git (/v1/workspace/git/*): git runs without blocking the gateway.
# Operations on the same repository run one at a time in arrival order; at most
# GIT_MAX_CONCURRENCY run at once overall, further requests wait (none is
# rejected). GIT_TIMEOUT_MS bounds one git command. Defaults: 3 and 120000.
# GIT_MAX_CONCURRENCY=3
# GIT_TIMEOUT_MS=120000

# Trusted model proxy: no-progress timeout per provider request, in ms (positive whole number; an invalid value stops startup)
# MODEL_PROXY_IDLE_TIMEOUT_MS=600000

# Agent isolation (every agent run starts in a bubblewrap sandbox)
# A sandbox must pass its start check within this many ms (positive whole number; an invalid value stops startup)
# ISOLATION_STARTUP_TIMEOUT_MS=10000
# Deadline of one query request, retries included, in ms (positive whole number)
# AGENT_RUN_TIMEOUT_MS=7200000
# Trusted storage of the sandbox homes (absolute path, private directory; default $HOME/.agent-sandbox)
# AGENT_SANDBOX_ROOT=/home/node/.agent-sandbox
# Isolation runtime (absolute path)
# AGENT_SANDBOX_BWRAP=/usr/bin/bwrap
