{
  "name": "agent-gateway",
  "version": "0.1.0",
  "type": "module",
  "description": "Standalone Claude Agent SDK service with REST API",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node --expose-gc dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run --exclude 'src/tests/e2e-*'",
    "test:e2e": "vitest run src/tests/e2e-*.test.ts",
    "probe:docker-stop": "node scripts/docker-stop-probe.mjs",
    "probe:docker-isolation": "node scripts/docker-isolation-probe.mjs",
    "probe:epic-integration": "node scripts/epic-integration-probe.mjs",
    "registry-url-inventory": "node scripts/registry-url-inventory.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.2",
    "dotenv": "^16.4.7",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.2",
    "@types/node": "^22.15.3",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.2",
    "supertest": "^7.2.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=22"
  }
}
